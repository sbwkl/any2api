{
  "name": "any2api",
  "version": "0.1.0",
  "type": "module",
  "description": "把各 AI 编程工具的私有 LLM 通道封装为通用 OpenAI 兼容 API（codearts / codebuddy / …）",
  "scripts": {
    "start": "bun src/index.ts",
    "e2e": "bun scripts/e2e/run.ts",
    "e2e:corpus": "bun scripts/e2e/corpus.ts",
    "test": "bun test",
    "check": "bun test && bun build src/index.ts --target=bun"
  }
}
